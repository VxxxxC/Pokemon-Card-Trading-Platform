# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# vscode
.vscode/

# dependencies
/node_modules
package-lock.json
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
.stryker-tmp/
.stryker-tmp-moderation/
reports/mutation/
e2e/.auth/
e2e/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.cursorrules(old)

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local DB dumps (scripts/dev/backup-db.sh)
/backups/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Serwist
public/sw*
public/swe-worker*
